# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Required: HuggingFace Token for dataset access
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Required: WandB API Key for experiment tracking
# Get from: https://wandb.ai/settings
WANDB_API_KEY=your_wandb_api_key_here

# Optional: WandB Project Name (default: rmnp)
WANDB_PROJECT=rmnp

# Optional: WandB Entity/Team Name
# WANDB_ENTITY=your_wandb_entity_here

# Optional: CUDA Visible Devices (default: 0,1,2,3,4,5,6,7)
# CUDA_VISIBLE_DEVICES=0,1,2,3
